{
  "schema_version": 1,
  "cohort": {
    "labels": [0, 1],
    "uncertain_label_policy": "exclude from primary training cohort",
    "views": ["AP", "PA"],
    "preprocessing_conditions": [
      "raw",
      "medsam3_seg",
      "medsam3_crop",
      "chexmask_seg",
      "chexmask_crop"
    ]
  },
  "split": {
    "unit": "subject_id",
    "split_seed": 42,
    "outer_test_ratio": 0.15,
    "outer_method": "StratifiedGroupKFold(n_splits=7), first split",
    "inner_cv_folds": 5,
    "inner_method": "StratifiedGroupKFold(shuffle=True, random_state=42)",
    "files": "splits/{AP,PA}_{outer_test,fold_assignment}.csv"
  },
  "training": {
    "input_size": 512,
    "learning_rate": 2e-05,
    "weight_decay": 0.05,
    "batch_size": 64,
    "dropout": 0.2,
    "epochs": 50,
    "early_stopping_patience": 8,
    "warmup_epochs": 3,
    "scheduler": "cosine",
    "loss": "weighted_bce",
    "positive_weight": "computed independently in each training fold as N_negative/N_positive",
    "negative_downsampling": false,
    "training_seed": 42,
    "best_checkpoint_selection": "validation AUROC",
    "threshold_selection": "Youden J on validation/OOF predictions",
    "full_backbone_fine_tuning": true,
    "normalization_mean": [0.485, 0.456, 0.406],
    "normalization_std": [0.229, 0.224, 0.225],
    "augmentation": {
      "horizontal_flip_probability": 0.0,
      "rotation_probability": 0.5,
      "rotation_degrees": 7,
      "brightness_contrast_probability": 0.3,
      "brightness_range": [0.9, 1.1],
      "contrast_range": [0.9, 1.1],
      "shift_probability": 0.5,
      "shift_limit": 0.05,
      "scale_probability": 0.5,
      "scale_limit": 0.1
    }
  },
  "model_overrides": {
    "eva_x_base": {
      "early_stopping_patience": 9
    },
    "rad_dino": {
      "early_stopping_patience": 9,
      "use_bfloat16": false,
      "use_float32": true
    },
    "all_other_models": {
      "use_bfloat16": true,
      "use_float32": false
    }
  },
  "evaluation": {
    "primary_metrics": ["AUROC", "AUPRC"],
    "outer_test_evaluation": "five-fold probability ensemble",
    "confidence_interval": "subject-level cluster bootstrap",
    "bootstrap_replicates": 2000,
    "bootstrap_seed": 42
  }
}
